APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

LOG_CHANNEL=stack
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=laravel
DB_USERNAME=root
DB_PASSWORD=

# Pilsan SQL Server (separate, read-only source database)
PILSAN_DB_HOST=172.31.5.101
PILSAN_DB_PORT=1433
PILSAN_DB_DATABASE=
PILSAN_DB_USERNAME=
PILSAN_DB_PASSWORD=
PILSAN_DB_ENCRYPT=yes
PILSAN_DB_TRUST_SERVER_CERTIFICATE=true

GTARABAR_HOST=${PILSAN_DB_HOST}
